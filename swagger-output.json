{
  "swagger": "2.0",
  "info": {
    "title": "Locadora API",
    "description": "Documentação completa das 26 rotas da API de Gestão e Aluguel de Veículos — com autenticação JWT, controle de acesso (Admin/Cliente), busca agregada, pagamentos integrais ou divididos e seguros.",
    "version": "1.0.0"
  },
  "host": "locadora-api-k59p.onrender.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "securityDefinitions": {
    "Bearer": {
      "type": "apiKey",
      "name": "Authorization",
      "in": "header",
      "description": "Insira: Bearer <seu_token_jwt>"
    }
  },
  "tags": [
    {
      "name": "Usuários",
      "description": "Cadastro, autenticação e gerenciamento de contas"
    },
    {
      "name": "Veículos",
      "description": "Consulta pública, busca filtrada e gerenciamento administrativo da frota"
    },
    {
      "name": "Aluguéis",
      "description": "Reserva, listagem e cancelamento de aluguéis"
    },
    {
      "name": "Pagamentos",
      "description": "Quitação integral ou dividida, estorno e relatório SQL (INNER JOIN)"
    },
    {
      "name": "Seguros",
      "description": "Contratação, consulta, cancelamento e relatórios gerenciais de apólices"
    }
  ],
  "paths": {
    "/cadastro/administrador": {
      "post": {
        "tags": ["Usuários"],
        "summary": "Cadastrar novo administrador (Público)",
        "description": "Cria um usuário com permissão administrativa (is_admin: true).",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "age", "email", "password"],
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Nome do Administrador"
                },
                "age": {
                  "type": "integer",
                  "example": 25
                },
                "email": {
                  "type": "string",
                  "example": "admin@exemplo.com"
                },
                "password": {
                  "type": "string",
                  "example": "sua_senha_segura"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Administrador cadastrado com sucesso"
          },
          "400": {
            "description": "Erro de validação ou e-mail já cadastrado"
          }
        }
      }
    },
    "/cadastro/cliente": {
      "post": {
        "tags": ["Usuários"],
        "summary": "Cadastrar novo cliente (Público)",
        "description": "Cria uma conta comum de cliente (is_admin: false).",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["name", "age", "email", "password"],
              "properties": {
                "name": {
                  "type": "string",
                  "example": "Pedro Alves"
                },
                "age": {
                  "type": "integer",
                  "example": 25
                },
                "email": {
                  "type": "string",
                  "example": "cliente@exemplo.com"
                },
                "password": {
                  "type": "string",
                  "example": "sua_senha_segura"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Cliente cadastrado com sucesso"
          },
          "400": {
            "description": "Erro de validação ou e-mail já cadastrado"
          }
        }
      }
    },
    "/login": {
      "post": {
        "tags": ["Usuários"],
        "summary": "Autenticar usuário e gerar token JWT (Público)",
        "description": "Valida e-mail e senha e retorna o token JWT para uso nas rotas protegidas.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["email", "password"],
              "properties": {
                "email": {
                  "type": "string",
                  "example": "usuario@exemplo.com"
                },
                "password": {
                  "type": "string",
                  "example": "sua_senha"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Autenticado com sucesso (retorna token JWT)"
          },
          "401": {
            "description": "Senha incorreta"
          },
          "404": {
            "description": "Usuário não encontrado"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/usuarios/todos": {
      "get": {
        "tags": ["Usuários"],
        "summary": "Listar todos os usuários (Apenas Admin)",
        "description": "Retorna todos os clientes e administradores cadastrados.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de usuários retornada com sucesso"
          },
          "401": {
            "description": "Token não fornecido ou inválido"
          },
          "403": {
            "description": "Acesso negado (requer privilégio de administrador)"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/usuarios/deletar/{id}": {
      "delete": {
        "tags": ["Usuários"],
        "summary": "Deletar usuário (Próprio usuário ou Admin)",
        "description": "Permite que o usuário apague a própria conta ou que um administrador remova qualquer conta.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 4
          }
        ],
        "responses": {
          "200": {
            "description": "Usuário removido com sucesso"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado"
          },
          "404": {
            "description": "Usuário não encontrado"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/veiculos": {
      "post": {
        "tags": ["Veículos"],
        "summary": "Cadastrar novo veículo (Apenas Admin)",
        "description": "Adiciona um novo veículo à frota da locadora com status inicial 'disponível'.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["marca", "modelo", "ano", "placa", "valor"],
              "properties": {
                "marca": {
                  "type": "string",
                  "example": "Chevrolet"
                },
                "modelo": {
                  "type": "string",
                  "example": "Onix Premier"
                },
                "ano": {
                  "type": "integer",
                  "example": 2025
                },
                "placa": {
                  "type": "string",
                  "example": "ABC1D23"
                },
                "valor": {
                  "type": "number",
                  "example": 150.00
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Veículo cadastrado com sucesso"
          },
          "400": {
            "description": "Dados inválidos ou placa já cadastrada"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/atualizar/{id}": {
      "put": {
        "tags": ["Veículos"],
        "summary": "Atualizar dados de um veículo (Apenas Admin)",
        "description": "Edita informações ou valor da diária de um veículo existente.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "marca": {
                  "type": "string",
                  "example": "Toyota"
                },
                "modelo": {
                  "type": "string",
                  "example": "Corolla XEi"
                },
                "ano": {
                  "type": "integer",
                  "example": 2024
                },
                "placa": {
                  "type": "string",
                  "example": "POX1A23"
                },
                "valor": {
                  "type": "number",
                  "example": 230.00
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo atualizado com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "404": {
            "description": "Veículo não encontrado"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/veiculos/deletar/{id}": {
      "delete": {
        "tags": ["Veículos"],
        "summary": "Remover veículo da frota (Apenas Admin)",
        "description": "Exclui um veículo pelo ID.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 5
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo removido com sucesso"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "404": {
            "description": "Veículo não encontrado"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/veiculos/todos": {
      "get": {
        "tags": ["Veículos"],
        "summary": "Listar todos os veículos (Público)",
        "description": "Exibe o catálogo completo de veículos cadastrados.",
        "responses": {
          "200": {
            "description": "Lista de veículos retornada com sucesso"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/buscar/{identificador}": {
      "get": {
        "tags": ["Veículos"],
        "summary": "Buscar veículo por ID (Público)",
        "description": "Consulta um veículo específico pelo ID informado na URL.",
        "parameters": [
          {
            "name": "identificador",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Veículo encontrado"
          },
          "404": {
            "description": "Veículo não encontrado"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/veiculos/busca": {
      "get": {
        "tags": ["Veículos"],
        "summary": "Pesquisar veículos por marca ou modelo com contagem de locações (Público)",
        "description": "Filtra veículos por termo (iLike em marca e modelo) e retorna a contagem de locações (COUNT + GROUP BY) de cada veículo.",
        "parameters": [
          {
            "name": "termo",
            "in": "query",
            "required": false,
            "type": "string",
            "description": "Termo de busca (marca ou modelo)",
            "example": "Honda"
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de veículos encontrados com total_locacoes"
          },
          "500": {
            "description": "Erro ao buscar veículos"
          }
        }
      }
    },
    "/alugar": {
      "post": {
        "tags": ["Aluguéis"],
        "summary": "Registrar novo aluguel (Usuário Logado)",
        "description": "Cria uma locação vinculando um usuário a um veículo no período informado e altera o status do veículo para 'alugado'.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["usuario_id", "veiculo_id", "data_inicio", "data_fim"],
              "properties": {
                "usuario_id": {
                  "type": "integer",
                  "example": 2
                },
                "veiculo_id": {
                  "type": "integer",
                  "example": 5
                },
                "data_inicio": {
                  "type": "string",
                  "example": "2026-11-16"
                },
                "data_fim": {
                  "type": "string",
                  "example": "2026-11-19"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Aluguel criado com sucesso"
          },
          "400": {
            "description": "Dados inválidos ou veículo indisponível"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado"
          },
          "404": {
            "description": "Usuário ou veículo não encontrado"
          }
        }
      }
    },
    "/alugueis/todos": {
      "get": {
        "tags": ["Aluguéis"],
        "summary": "Listar todos os aluguéis (Apenas Admin)",
        "description": "Retorna todos os aluguéis registrados no sistema.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de aluguéis"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/alugueis/cancelar/{id}": {
      "delete": {
        "tags": ["Aluguéis"],
        "summary": "Cancelar aluguel (Dono do aluguel ou Admin)",
        "description": "Cancela um aluguel existente e devolve o veículo para status 'disponível'.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 10
          }
        ],
        "responses": {
          "200": {
            "description": "Aluguel cancelado com sucesso"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado"
          },
          "404": {
            "description": "Aluguel não encontrado"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/pagamentos/relatorio": {
      "get": {
        "tags": ["Pagamentos"],
        "summary": "Relatório financeiro em SQL puro (INNER JOIN) (Apenas Admin)",
        "description": "Executa consulta SQL nativa juntando payments e rentals ordenada pela data mais recente.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Relatório financeiro gerado com sucesso"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/pagamentos": {
      "post": {
        "tags": ["Pagamentos"],
        "summary": "Registrar pagamento integral ou dividido (Dono do aluguel ou Admin)",
        "description": "Permite 1 ou mais pagamentos para o mesmo aluguel em métodos diferentes. Calcula diárias + seguro ativo, bloqueia valores acima do saldo devedor e retorna o resumo_financeiro atualizado.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["rental_id", "valor", "data", "metodo_pagamento"],
              "properties": {
                "rental_id": {
                  "type": "integer",
                  "example": 11
                },
                "valor": {
                  "type": "number",
                  "example": 250.00
                },
                "data": {
                  "type": "string",
                  "example": "2026-11-16"
                },
                "metodo_pagamento": {
                  "type": "string",
                  "enum": ["PIX", "Cartão de Crédito", "Cartão de Débito", "Dinheiro"],
                  "example": "PIX"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Pagamento registrado (retorna payment e resumo_financeiro)"
          },
          "400": {
            "description": "Aluguel já quitado ou valor maior que o saldo devedor"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (aluguel pertence a outro cliente)"
          },
          "404": {
            "description": "Aluguel ou veículo não encontrado"
          }
        }
      }
    },
    "/pagamentos/todos": {
      "get": {
        "tags": ["Pagamentos"],
        "summary": "Listar todos os pagamentos (Apenas Admin)",
        "description": "Retorna todos os registros da tabela payments.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de pagamentos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/pagamentos/{id}": {
      "get": {
        "tags": ["Pagamentos"],
        "summary": "Buscar pagamento por ID (Dono do aluguel ou Admin)",
        "description": "Retorna os dados de um pagamento específico caso pertença ao usuário logado ou seja administrador.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Dados do pagamento"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado"
          },
          "404": {
            "description": "Pagamento não encontrado"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      },
      "put": {
        "tags": ["Pagamentos"],
        "summary": "Atualizar pagamento (Apenas Admin)",
        "description": "Permite ao administrador corrigir valor, data ou método de um lançamento financeiro.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "valor": {
                  "type": "number",
                  "example": 810.00
                },
                "data": {
                  "type": "string",
                  "example": "2026-11-16"
                },
                "metodo_pagamento": {
                  "type": "string",
                  "example": "PIX"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pagamento atualizado com sucesso"
          },
          "400": {
            "description": "Dados inválidos"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "404": {
            "description": "Pagamento não encontrado"
          }
        }
      },
      "delete": {
        "tags": ["Pagamentos"],
        "summary": "Deletar/estornar pagamento (Apenas Admin)",
        "description": "Remove um registro financeiro do banco de dados.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "integer",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Pagamento removido com sucesso"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "404": {
            "description": "Pagamento não encontrado"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/seguro/relatorio": {
      "get": {
        "tags": ["Seguros"],
        "summary": "Relatório de seguros ativos (COUNT) (Apenas Admin)",
        "description": "Conta quantas apólices estão com status 'ativo' no sistema.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Contagem de seguros ativos retornada"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "500": {
            "description": "Erro interno no servidor"
          }
        }
      }
    },
    "/seguro/relatorio/tipos": {
      "get": {
        "tags": ["Seguros"],
        "summary": "Relatório de seguros ativos agrupados por tipo (GROUP BY) (Apenas Admin)",
        "description": "Agrupa as apólices ativas por tipo_seguro e calcula COUNT, SUM, MIN e MAX dos valores.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Estatísticas agrupadas por tipo_seguro"
          },
          "401": {
            "description": "Não autenticado"
          },
          "403": {
            "description": "Acesso negado (requer Admin)"
          },
          "500": {
            "description": "Erro ao gerar relatório por tipo"
          }
        }
      }
    },
    "/seguros": {
      "post": {
        "tags": ["Seguros"],
        "summary": "Contratar seguro para um aluguel (Dono do aluguel ou Admin)",
        "description": "Cria uma apólice ativa vinculada ao aluguel informado.",
        "security": [
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["aluguel_id", "tipo_seguro", "valor"],
              "properties": {
                "aluguel_id": {
